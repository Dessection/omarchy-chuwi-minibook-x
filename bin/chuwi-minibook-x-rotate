#!/usr/bin/env python3
"""
Auto-rotation daemon for Chuwi MiniBook X (Intel N100) running Omarchy / Hyprland.
Listens to the onboard mxc4005 accelerometer via iio-sensor-proxy (D-Bus)
and updates both display and touchscreen orientation in real time.
"""

import json
import math
import subprocess
import sys
from gi.repository import GLib, Gio

# Orientation mappings for Chuwi MiniBook X (native portrait 1200x1920 DSI-1 panel):
# - "right-up": standard laptop orientation (keyboard down) -> transform 3 (270 deg)
# - "normal": standing portrait (power button top) -> transform 0 (0 deg)
# - "left-up": inverted landscape / tent mode -> transform 1 (90 deg)
# - "bottom-up": inverted portrait -> transform 2 (180 deg)
ORIENTATION_TO_TRANSFORM = {
    "right-up": 3,
    "normal": 0,
    "left-up": 1,
    "bottom-up": 2,
}

current_transform = None

def hyprctl(*args):
    result = subprocess.run(["hyprctl", *args], capture_output=True, text=True,
                            check=True, timeout=10)
    output = result.stdout.strip()
    if args[0] == "eval" and output.lower() != "ok":
        raise RuntimeError(f"hyprctl eval: {output or result.stderr}")
    return output


def apply_transform(transform):
    global current_transform
    if transform is None or transform == current_transform:
        return
    try:
        monitors = json.loads(hyprctl("monitors", "-j"))
        monitor = next(m for m in monitors if m["name"] == "DSI-1")
        scale = float(monitor["scale"])
        if not math.isfinite(scale) or scale <= 0:
            raise ValueError("Invalid display scale")
        hyprctl("eval", f'hl.monitor({{ output = "DSI-1", transform = {transform}, scale = {scale} }})')
        hyprctl("eval", f'hl.device({{ name = "goodix-capacitive-touchscreen-1", output = "DSI-1", transform = {transform} }})')
        hyprctl("eval", f'hl.config({{ input = {{ touchdevice = {{ output = "DSI-1", transform = {transform} }} }} }})')
    except (OSError, subprocess.SubprocessError, ValueError, KeyError,
            StopIteration, TypeError, RuntimeError) as error:
        print(f"Rotation failed: {error}", file=sys.stderr, flush=True)
        return
    current_transform = transform


def on_properties_changed(connection, sender_name, object_path, interface_name, signal_name, parameters, user_data):
    if parameters and len(parameters) >= 2:
        changed_props = parameters[1]
        if "AccelerometerOrientation" in changed_props:
            orientation = changed_props["AccelerometerOrientation"]
            if orientation in ORIENTATION_TO_TRANSFORM:
                apply_transform(ORIENTATION_TO_TRANSFORM[orientation])

def main():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception as e:
        sys.stderr.write(f"Failed to connect to system D-Bus: {e}\n")
        sys.exit(1)

    bus.signal_subscribe(
        "net.hadess.SensorProxy", "org.freedesktop.DBus.Properties",
        "PropertiesChanged", "/net/hadess/SensorProxy", None,
        Gio.DBusSignalFlags.NONE, on_properties_changed, None
    )

    # Claim accelerometer from iio-sensor-proxy
    try:
        bus.call_sync(
            "net.hadess.SensorProxy",
            "/net/hadess/SensorProxy",
            "net.hadess.SensorProxy",
            "ClaimAccelerometer",
            None,
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None
        )
    except Exception as e:
        sys.stderr.write(f"Failed to claim accelerometer: {e}\n")
        sys.exit(1)

    # Read current orientation
    try:
        val = bus.call_sync(
            "net.hadess.SensorProxy",
            "/net/hadess/SensorProxy",
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", ("net.hadess.SensorProxy", "AccelerometerOrientation")),
            GLib.VariantType("(v)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None
        )
        if val:
            orientation = val[0]
            if orientation in ORIENTATION_TO_TRANSFORM:
                apply_transform(ORIENTATION_TO_TRANSFORM[orientation])
            else:
                apply_transform(3)
        else:
            apply_transform(3)
    except Exception:
        apply_transform(3)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
